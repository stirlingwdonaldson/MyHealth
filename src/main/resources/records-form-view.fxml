
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-padding: 8 20 8 20; -fx-spacing: 8; -fx-max-width: INFINITY;" BorderPane.alignment="CENTER_LEFT">
         <children>
            <HBox alignment="CENTER">
               <children>
                  <Label style="-fx-font-size: 16;" text="MyHealth">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Region minHeight="0.0" minWidth="0.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="fullNameLabel" text="Full Name" />
            <Separator orientation="VERTICAL" prefHeight="200.0" />
            <Label fx:id="usernameLabel" text="username" />
            <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #fafafa; -fx-text-fill: #18181b; -fx-font-size: 10px; -fx-font-weight: 800; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #18181b; -fx-border-width: 1px;" text="Log Out" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefHeight="721.0" prefWidth="160.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0; -fx-padding: 8 8 4 8; -fx-spacing: 8;" BorderPane.alignment="CENTER">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <children>
            <Button cache="true" centerShape="false" depthTest="ENABLE" graphicTextGap="5.0" mnemonicParsing="false" onAction="#handleShowDashboard" style="-fx-max-width: INFINITY; -fx-background-color: transparent; -fx-background-radius: 5; -fx-border-radius: 5; -fx-text-alignment: center-left; -fx-alignment: center-left; -fx-cursor: hand;" text="Dashboard" VBox.vgrow="ALWAYS" />
            <Button cache="true" cacheHint="QUALITY" centerShape="false" depthTest="ENABLE" graphicTextGap="5.0" mnemonicParsing="false" onAction="#handleShowRecords" style="-fx-max-width: INFINITY; -fx-background-color: transparent; -fx-background-radius: 5; -fx-border-radius: 5; -fx-alignment: center-left; -fx-cursor: hand;" text="Health Records" />
            <Button cache="true" cacheHint="QUALITY" centerShape="false" depthTest="ENABLE" graphicTextGap="5.0" mnemonicParsing="false" style="-fx-max-width: INFINITY; -fx-background-color: #E0F2FE; -fx-background-radius: 5; -fx-border-radius: 5; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-weight: bold;" text="Add Record" />
            <Region prefWidth="200.0" VBox.vgrow="ALWAYS" />
            <Button cache="true" cacheHint="QUALITY" centerShape="false" depthTest="ENABLE" graphicTextGap="5.0" mnemonicParsing="false" onAction="#handleShowProfile" style="-fx-max-width: INFINITY; -fx-background-color: transparent; -fx-background-radius: 5; -fx-border-radius: 5; -fx-alignment: center-left; -fx-cursor: hand;" text="Profile" />
         </children>
      </VBox>
   </left>
   <bottom>
      <HBox prefHeight="30.0" prefWidth="200.0" style="-fx-background-color: #F3F4F6; -fx-border-color: #E5E7EB;" BorderPane.alignment="CENTER" />
   </bottom>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #F9FAFB; -fx-padding: 24; -fx-spacing: 14;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Add Health Record" />
            <Label text="Enter any health details you want to save. At least one field is required." textFill="#486581" />
            <VBox maxWidth="620.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 18; -fx-spacing: 12;">
               <children>
                  <VBox style="-fx-spacing: 4;">
                     <children>
                        <Label text="Weight" />
                        <TextField fx:id="weightField" promptText="Optional, for example 72.5" />
                     </children>
                  </VBox>
                  <VBox style="-fx-spacing: 4;">
                     <children>
                        <Label text="Temperature" />
                        <TextField fx:id="temperatureField" promptText="Optional, for example 36.8" />
                     </children>
                  </VBox>
                  <VBox style="-fx-spacing: 4;">
                     <children>
                        <Label text="Blood Pressure" />
                        <TextField fx:id="bloodPressureField" promptText="Optional, for example 120/80" />
                     </children>
                  </VBox>
                  <VBox style="-fx-spacing: 4;">
                     <children>
                        <Label text="Note" />
                        <TextArea fx:id="noteField" prefRowCount="5" promptText="Optional note, maximum 50 words" wrapText="true" />
                     </children>
                  </VBox>
                  <HBox style="-fx-spacing: 10;">
                     <children>
                        <Button defaultButton="true" mnemonicParsing="false" onAction="#handleSaveRecord" style="-fx-background-color: #0074E7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-radius: 6px;" text="Save Record" />
                        <Button mnemonicParsing="false" onAction="#handleClearForm" style="-fx-background-color: #FFFFFF; -fx-text-fill: #18181b; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #CBD5E1;" text="Clear" />
                        <Button mnemonicParsing="false" onAction="#handleShowRecords" style="-fx-background-color: #FFFFFF; -fx-text-fill: #18181b; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #CBD5E1;" text="Cancel" />
                     </children>
                  </HBox>
                  <Label fx:id="recordMessageLabel" style="-fx-text-fill: #486581; -fx-font-size: 12px;" text="" wrapText="true" />
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
