<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-padding: 8 20 8 20; -fx-spacing: 8; -fx-max-width: INFINITY;" BorderPane.alignment="CENTER_LEFT">
         <children>
            <HBox alignment="CENTER">
               <children>
                  <Label style="-fx-font-size: 16;" text="MyHealth">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Region minHeight="0.0" minWidth="0.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="fullNameLabel" text="Full Name" />
            <Separator orientation="VERTICAL" prefHeight="200.0" />
            <Label fx:id="usernameLabel" text="username" />
            <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #fafafa; -fx-text-fill: #18181b; -fx-font-size: 10px; -fx-font-weight: 800; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #18181b; -fx-border-width: 1px;" text="Log Out" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefHeight="721.0" prefWidth="160.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0; -fx-padding: 8 8 4 8; -fx-spacing: 8;" BorderPane.alignment="CENTER">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <children>
            <Button cache="true" centerShape="false" depthTest="ENABLE" graphicTextGap="5.0" mnemonicParsing="false" onAction="#handleShowDashboard" style="-fx-max-width: INFINITY; -fx-background-color: transparent; -fx-background-radius: 5; -fx-border-radius: 5; -fx-text-alignment: center-left; -fx-alignment: center-left; -fx-cursor: hand;" text="Dashboard" VBox.vgrow="ALWAYS" />
            <Button cache="true" cacheHint="QUALITY" centerShape="false" depthTest="ENABLE" graphicTextGap="5.0" mnemonicParsing="false" style="-fx-max-width: INFINITY; -fx-background-color: #E0F2FE; -fx-background-radius: 5; -fx-border-radius: 5; -fx-alignment: center-left; -fx-cursor: hand; -fx-font-weight: bold;" text="Health Records" />
            <Button cache="true" cacheHint="QUALITY" centerShape="false" depthTest="ENABLE" graphicTextGap="5.0" mnemonicParsing="false" style="-fx-max-width: INFINITY; -fx-background-color: transparent; -fx-background-radius: 5; -fx-border-radius: 5; -fx-alignment: center-left; -fx-cursor: hand;" text="Add Record" />
            <Region prefWidth="200.0" VBox.vgrow="ALWAYS" />
            <Button cache="true" cacheHint="QUALITY" centerShape="false" depthTest="ENABLE" graphicTextGap="5.0" mnemonicParsing="false" onAction="#handleShowProfile" style="-fx-max-width: INFINITY; -fx-background-color: transparent; -fx-background-radius: 5; -fx-border-radius: 5; -fx-alignment: center-left; -fx-cursor: hand;" text="Profile" />
         </children>
      </VBox>
   </left>
   <bottom>
      <HBox prefHeight="30.0" prefWidth="200.0" style="-fx-background-color: #F3F4F6; -fx-border-color: #E5E7EB;" BorderPane.alignment="CENTER" />
   </bottom>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #F9FAFB; -fx-padding: 24; -fx-spacing: 14;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" style="-fx-spacing: 12;">
               <children>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Health Records" />
                        <Label text="View your saved health history. Records are shown newest first." textFill="#486581" />
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" onAction="#handleRefreshRecords" style="-fx-background-color: #FFFFFF; -fx-text-fill: #18181b; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #CBD5E1;" text="Refresh" />
               </children>
            </HBox>
            <Label fx:id="recordsMessageLabel" style="-fx-text-fill: #486581; -fx-font-size: 12px;" text="" wrapText="true" />
            <TableView fx:id="recordsTable" prefHeight="520.0" prefWidth="900.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="dateColumn" prefWidth="110.0" text="Date" />
                  <TableColumn fx:id="weightColumn" prefWidth="110.0" text="Weight" />
                  <TableColumn fx:id="temperatureColumn" prefWidth="130.0" text="Temperature" />
                  <TableColumn fx:id="bloodPressureColumn" prefWidth="150.0" text="Blood Pressure" />
                  <TableColumn fx:id="noteColumn" prefWidth="380.0" text="Note" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>

